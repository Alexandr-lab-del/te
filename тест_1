from rest_framework.test import APITestCase
from habits.models import Habit, Profile
from django.test import TestCase
from django.contrib.auth.models import User
from rest_framework.authtoken.models import Token


class HabitModelTests(TestCase):
    def setUp(self):
        self.user = User.objects.create_user(username='testuser', password='testpass')

    def test_habit_constraints(self):
        habit = Habit.objects.create(
            user=self.user,
            name="Evening Read",
            location="Office",
            time="20:00",
            action="Read a book",
            periodicity=1,
            reward="Watch TV",
            duration=100
        )
        self.assertTrue(habit.reward)
        self.assertIsNone(habit.related_habit)

    def test_profile_creation(self):
        profile = self.user.profile
        self.assertEqual(profile.user, self.user)
        self.assertIsNone(profile.telegram_chat_id)

    # Новый тест для проверки связанности привычек
    def test_related_habit(self):
        first_habit = Habit.objects.create(
            user=self.user,
            name="Morning Walk",
            location="Park",
            time="07:00",
            action="Walk",
            periodicity=1,
            duration=30
        )
        second_habit = Habit.objects.create(
            user=self.user,
            name="Evening Meditation",
            location="Home",
            time="19:00",
            action="Meditate",
            periodicity=1,
            duration=20,
            related_habit=first_habit
        )
        self.assertEqual(second_habit.related_habit, first_habit)


class HabitConstraintTests(TestCase):
    def setUp(self):
        self.user = User.objects.create_user(username='testuser', password='testpass')

    def test_duration_exceeding_limit(self):
        with self.assertRaises(Exception):
            Habit.objects.create(
                user=self.user,
                name="Too Long Habit", action="Long Activity", duration=150
            )

    # Новый тест на граничные значения продолжительности привычки
    def test_max_duration(self):
        habit = Habit.objects.create(
            user=self.user,
            name="Morning Run",
            location="Park",
            time="08:00",  # Убедитесь, что это поле присутствует
            action="Run",
            periodicity=2,
            reward="Healthy Breakfast",
            duration=30
        )
        self.assertEqual(habit.duration, 30)


