class HabitSerializerTests(TestCase):
    def setUp(self):
        self.user = User.objects.create_user(username='testuser', password='testpass')
        self.habit = Habit.objects.create(
            user=self.user,
            name="Reading",
            location="Library",
            time="19:00",
            action="Read Books",
            periodicity=2,
            is_enjoyable=True,
            duration=60
        )

    def test_habit_serialization(self):
        from habits.serializers import HabitSerializer
        serializer = HabitSerializer(self.habit)
        self.assertEqual(serializer.data['name'], "Reading")
        self.assertEqual(serializer.data['location'], "Library")


class TelegramBotTests(TestCase):
    def setUp(self):
        self.user = User.objects.create_user(username='telegramuser', password='testpass')
        self.user.profile.telegram_chat_id = "123456789"
        self.user.profile.save()

    def test_profile_telegram_chat_id(self):
        profile = self.user.profile
        self.assertEqual(profile.telegram_chat_id, "123456789")


# Новый тест для проверки связи с Celery
class CeleryTaskTests(TestCase):
    def setUp(self):
        self.user = User.objects.create_user(username='celeryuser', password='testpass')
        self.habit = Habit.objects.create(
            user=self.user,
            name="Habit for Celery",
            location="Home",
            time="12:00",
            action="Do something",
            periodicity=1,
            duration=30
        )

    def test_periodic_task_created(self):
        from django_celery_beat.models import PeriodicTask
        task_name = f'Habit Reminder {self.habit.id}'
        task = PeriodicTask.objects.filter(name=task_name).first()
        self.assertIsNotNone(task)
        self.assertEqual(task.task, 'habits.tasks.send_habit_reminder')
